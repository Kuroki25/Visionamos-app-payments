NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1

# Root origin of the NestJS Better Auth instance — see apps/api/.env.example
# BETTER_AUTH_URL. Must point at the same host as NEXT_PUBLIC_API_URL (Better
# Auth is mounted on the same NestJS server, at /api/auth, outside the
# api/v1 prefix). docs/frontend/DASHBOARD_FRONTEND_SOURCE_OF_TRUTH.md.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:4100
