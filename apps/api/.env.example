NODE_ENV=development
# Non-default ports across this whole project (3100/3101/4100/5442) —
# deliberately away from the 3000/3001/4000/5432 conventional defaults so
# this project doesn't collide with other projects' dev servers running
# concurrently on the same machine.
PORT=4100
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3101
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5442
DB_USERNAME=visionamos
DB_PASSWORD=visionamos
DB_NAME=visionamos
DB_SSL=false

# Generate real secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-real-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-real-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Cookies default to Secure (HTTPS-only, per docs/adr/006). Set to false only
# for local development over plain http://localhost.
COOKIE_SECURE=false

# Only read by `pnpm seed:superadmin` (src/scripts/seed-superadmin.ts), never
# by the running app — deliberately NOT part of EnvSchema (docs/adr/010/011).
# There is no public self-registration in Red Coopagos; this is the only way
# to create the very first AppUser. Password must be >=12 characters (same
# policy as every other account).
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=replace-with-a-real-password-at-least-12-chars
SUPERADMIN_FULL_NAME=Super Admin
