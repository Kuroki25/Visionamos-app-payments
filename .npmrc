# Fail install if the active Node.js version doesn't satisfy each package.json's
# "engines" field, instead of silently continuing on an unsupported runtime.
engine-strict=true

# pnpm 11 moved workspace-level settings (strictPeerDependencies,
# disallowWorkspaceCycles, minimumReleaseAge, allowBuilds, catalogs) out of
# .npmrc and into pnpm-workspace.yaml — see that file and
# docs/DEPENDENCY_POLICY.md for what each one protects against.
